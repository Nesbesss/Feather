# Local builds, signing material and macOS metadata.
/build/
/dist/
/out/
/Feather.xcodeproj/
/Support/Local.xcconfig
.DS_Store
__pycache__/
*.pyc
*.xcuserstate
xcuserdata/
*.p12
*.p8
*.key
*.mobileprovision
*.provisionprofile
.env
.env.*

# Publish reproducible browser tools, never local lab profiles or web deploys.
/Website/
/Tools/*
!/Tools/Release/
!/Tools/BlocklistSources/
!/Tools/MakeBlocklist/
!/Tools/make-icon.swift
!/Tools/make-blocklist.sh
!/Tools/feather-agent.py
!/Tools/feather.mjs
!/Tools/test_feather_agent.py
!/Tools/feather-agent.test.mjs
!/Tools/feather-agent.live.mjs
!/Tools/YouTubeLab/
/Tools/YouTubeLab/*
!/Tools/YouTubeLab/upstream/
!/Tools/ExtensionsLab/
/Tools/ExtensionsLab/*
!/Tools/ExtensionsLab/generic-native-smoke.swift
!/Tools/ExtensionsLab/run-host-smoke.sh
!/Tools/ExtensionsLab/host-smoke.swift
!/Tools/StudyToolsLab/
/Tools/StudyToolsLab/*
!/Tools/StudyToolsLab/service-worker.test.mjs
!/Tools/StudyToolsLab/native-smoke.swift
!/Tools/LaunchSplashLab/
/Tools/LaunchSplashLab/*
!/Tools/LaunchSplashLab/native-qa.swift
!/Tools/LaunchSplashLab/run-native-qa.sh

# Historical research remains local; the public guide is self-contained.
/docs/*
!/docs/User-Guide.md
!/docs/Agent-Automation.md
!/docs/First-Run-Experience.md
!/docs/Releasing.md
!/docs/Release-Readiness.md
